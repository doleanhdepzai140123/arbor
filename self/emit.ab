// emit.ab — C# code generator for the self-hosted compiler.
// Walks the Node IR produced by parser.ab and emits C# 5-compatible
// source with a self-contained runtime prelude (RT). Every ARBOR value
// is an `object`: long/double/string/bool, ABV arrays, STC structs,
// OV optionals/enums. Function names are emitted as F_<name> statics;
// user methods as F_Type__name(self, ...).

use "./parser.ab"

struct Em {
  out: [Str]
  ind: Int
  tmp: Int
  origs: [Str]
  mngs: [Str]
  fnret: Str
  fns: [Str]
}

struct EmScope {
  orig: [Str]
  mng: [Str]
}

fn em_line(e: inout Em, s: Str) {
  var pad = ""
  var i = 0
  while i < e.ind {
    pad += "    "
    i += 1
  }
  e.out.push(pad + s)
}

fn fresh(e: inout Em) -> Int {
  e.tmp += 1
  e.tmp
}

// ---------- local renaming (block scoping + C# shadowing workaround) ----------

fn es_push(es: inout [EmScope]) {
  var s = EmScope { orig: [], mng: [] }
  es.push(s)
}

fn es_pop(es: inout [EmScope]) {
  drop(es.pop())
}

fn es_declare(e: inout Em, es: inout [EmScope], nm: Str) -> Str {
  let id = fresh(e)
  let mng = nm + "_{id}"
  let last = es.len() - 1
  var fr = es.get(last).unwrap()
  fr.orig.push(nm)
  fr.mng.push(mng)
  mng
}

fn es_lookup(es: in [EmScope], nm: Str) -> Str {
  var i = es.len()
  while i > 0 {
    i -= 1
    let fr = es.get(i).unwrap()
    var j = 0
    while j < fr.orig.len() {
      if fr.orig.get(j).unwrap() == nm {
        return fr.mng.get(j).unwrap()
      }
      j += 1
    }
  }
  "missing_{nm}"
}

// ---------- string escaping ----------

fn decode_arbor_str(raw: Str) -> Str {
  var out = ""
  let cs = raw.chars()
  let n = raw.len()
  var i = 1
  while i < n - 1 {
    let ch = cs.get(i).unwrap()
    if ch == "\\" and i + 1 < n - 1 {
      let nx = cs.get(i + 1).unwrap()
      if nx == "n" {
        out += "\n"
      } else if nx == "t" {
        out += "\t"
      } else if nx == "r" {
        out += "\r"
      } else if nx == "\"" {
        out += "\""
      } else if nx == "\\" {
        out += "\\"
      } else if nx == "\{" {
        out += "\{"
      } else if nx == "\}" {
        out += "\}"
      } else {
        out += nx
      }
      i += 2
    } else {
      out += ch
      i += 1
    }
  }
  out
}

fn cs_escape(s: Str) -> Str {
  var out = ""
  let cs = s.chars()
  let n = s.len()
  var i = 0
  while i < n {
    let ch = cs.get(i).unwrap()
    if ch == "\"" {
      out += "\\\""
    } else if ch == "\\" {
      out += "\\\\"
    } else if ch == "\n" {
      out += "\\n"
    } else if ch == "\t" {
      out += "\\t"
    } else if ch == "\r" {
      out += "\\r"
    } else {
      out += ch
    }
    i += 1
  }
  out
}

// ---------- expressions ----------

fn emit_expr(e: inout Em, n: in Node, es: inout [EmScope]) -> Str {
  if n.tag == "int" {
    return "(object){n.s1}L"
  }
  if n.tag == "float" {
    return "(object){n.s1}"
  }
  if n.tag == "str" {
    return "\"{cs_escape(decode_arbor_str(n.s1))}\""
  }
  if n.tag == "bool" {
    return "(object){n.s1}"
  }
  if n.tag == "ident" {
    return es_lookup(es, n.s1)
  }
  if n.tag == "binop" {
    let l = emit_expr(e, n.kids.get(0).unwrap(), es)
    let rr = emit_expr(e, n.kids.get(1).unwrap(), es)
    return emit_binop(n.s1, l, rr)
  }
  if n.tag == "unop" {
    let v = emit_expr(e, n.kids.get(0).unwrap(), es)
    if n.s1 == "-" {
      return "RT.Neg({v})"
    }
    return "RT.Not({v})"
  }
  if n.tag == "fieldget" {
    let recv = emit_expr(e, n.kids.get(0).unwrap(), es)
    return "RT.FGet({recv}, \"{n.s1}\")"
  }
  if n.tag == "index" {
    let obj = emit_expr(e, n.kids.get(0).unwrap(), es)
    let idx = emit_expr(e, n.kids.get(1).unwrap(), es)
    return "RT.Get({obj}, {idx})"
  }
  if n.tag == "arrlit" {
    var parts: [Str] = []
    var i = 0
    while i < n.kids.len() {
      let item = n.kids.get(i).unwrap()
      parts.push(emit_expr(e, item, es))
      i += 1
    }
    var joined = join_csv(parts)
    return "RT.Arr({joined})"
  }
  if n.tag == "structlit" {
    var names: [Str] = []
    var vals: [Str] = []
    var i = 0
    while i < n.kids.len() {
      let fv = n.kids.get(i).unwrap()
      names.push("\"{fv.s1}\"")
      vals.push(emit_expr(e, fv.kids.get(0).unwrap(), es))
      i += 1
    }
    let nlit = join_csv(names)
    var vlit = join_csv(vals)
    return "RT.StructNew(\"{n.s1}\", new string[] \{ {nlit} \}, new object[] \{ {vlit} \})"
  }
  if n.tag == "call" {
    return emit_call(e, n, es)
  }
  if n.tag == "if" {
    return emit_if_expr(e, n, es)
  }
  if n.tag == "interp" {
    return emit_expr(e, n.kids.get(0).unwrap(), es)
  }
  "RT.UNIT /* unhandled {n.tag} */"
}

fn emit_binop(op: Str, l: Str, rr: Str) -> Str {
  if op == "+" { return "RT.Add({l}, {rr})" }
  if op == "-" { return "RT.Sub({l}, {rr})" }
  if op == "*" { return "RT.Mul({l}, {rr})" }
  if op == "/" { return "RT.Div({l}, {rr})" }
  if op == "%" { return "RT.Rem({l}, {rr})" }
  if op == "==" { return "RT.Eq({l}, {rr})" }
  if op == "!=" { return "RT.Not(RT.Eq({l}, {rr}))" }
  if op == "<" { return "RT.Lt({l}, {rr})" }
  if op == ">" { return "RT.Gt({l}, {rr})" }
  if op == "<=" { return "RT.Le({l}, {rr})" }
  if op == ">=" { return "RT.Ge({l}, {rr})" }
  if op == "and" { return "((bool)(object)RT.Truthy({l}) ? {rr} : (object)false)" }
  if op == "or" { return "(RT.Truthy({l}) ? (object)true : {rr})" }
  "RT.UNIT"
}

// call shapes from the parser:
//   s1 == ""            -> direct call, callee name = kids[0].s1
//   s1 != "", kids[0]=ident -> qualified (module fn after flattening,
//                          enum ctor, or method on a local)
//   s1 != "", else      -> method on computed receiver
fn emit_call(e: inout Em, n: in Node, es: inout [EmScope]) -> Str {
  var recv_node = n.kids.get(0).unwrap()
  var args: [Str] = []
  var ai = 1
  while ai < n.kids.len() {
    let a = n.kids.get(ai).unwrap()
    args.push(emit_expr(e, a, es))
    ai += 1
  }
  let alist = join_csv(args)
  if n.s1 == "" {
    // direct call — check builtins first
    let nm = recv_node.s1
    if nm == "println" {
      return "RT.Println({alist})"
    }
    if nm == "print" {
      return "RT.Print({alist})"
    }
    if nm == "assert" {
      return "RT.Assert({alist})"
    }
    if nm == "assert_eq" {
      return "RT.AssertEq({alist})"
    }
    if nm == "drop" {
      return "RT.Eval({alist})"
    }
    let callee = es_lookup(es, nm)
    if callee == "missing_{nm}" {
      // global function (flat namespace)
      return "F_{nm}({alist})"
    }
    return "{callee}({alist})"
  }
  if recv_node.tag == "ident" {
    let qual_local = es_lookup(es, recv_node.s1)
    if qual_local != "missing_{recv_node.s1}" {
      return "RT.MCall({qual_local}, \"{n.s1}\", new object[] \{ {alist} \})"
    }
    // imported-module function (flat namespace) — checked by the checker
    if in_str_list(e.fns, n.s1) {
      return "F_{n.s1}({alist})"
    }
    if n.s1 == "Some" {
      return "RT.Some({alist})"
    }
    if n.s1 == "None" {
      return "RT.None()"
    }
    if n.s1 == "Ok" {
      return "RT.Ok({alist})"
    }
    if n.s1 == "Err" {
      return "RT.Err({alist})"
    }
    return "RT.EnumNew(\"{recv_node.s1}\", \"{n.s1}\", new object[] \{ {alist} \})"
  }
  if recv_node.tag == "fieldget" {
    let base = recv_node.kids.get(0).unwrap()
    if base.tag == "ident" and base.s1 == "std" and recv_node.s1 == "fs" {
      if n.s1 == "read_file" {
        return "RT.ReadFile({alist})"
      }
      if n.s1 == "write_file" {
        return "RT.WriteFile({alist})"
      }
    }
    if base.tag == "ident" and base.s1 == "std" and recv_node.s1 == "env" and n.s1 == "args" {
      return "RT.Args()"
    }
    if base.tag == "ident" and base.s1 == "std" and recv_node.s1 == "process" and n.s1 == "exit" {
      return "RT.Exit({alist})"
    }
    if base.tag == "ident" and base.s1 == "std" and recv_node.s1 == "process" and n.s1 == "exec" {
      return "RT.Exec({alist})"
    }
  }
  let recv = emit_expr(e, recv_node, es)
  "RT.MCall({recv}, \"{n.s1}\", new object[] \{ {alist} \})"
}

// if used as an expression: evaluate arms into a fresh temp, yield temp.
// Arm blocks contribute their trailing expression-statement value; nested
// else-if chains share the same temp.
fn emit_if_expr(e: inout Em, n: in Node, es: inout [EmScope]) -> Str {
  let tid = fresh(e)
  em_line(e, "object v_{tid} = RT.UNIT;")
  var indent_snapshot = e.ind
  emit_if_chain(e, n, es, tid)
  e.ind = indent_snapshot
  "v_{tid}"
}

fn emit_if_chain(e: inout Em, n: in Node, es: inout [EmScope], tid: Int) {
  let cond = emit_expr(e, n.kids.get(0).unwrap(), es)
  em_line(e, "if (RT.Truthy({cond}))")
  em_line(e, "\{")
  e.ind += 1
  es_push(es)
  let thenb = n.kids.get(1).unwrap()
  emit_arm_body(e, thenb, es, tid)
  es_pop(es)
  e.ind -= 1
  em_line(e, "\}")
  if n.kids.len() > 2 {
    let els = n.kids.get(2).unwrap()
    if els.tag == "if" {
      em_line(e, "else")
      emit_if_chain(e, els, es, tid)
      return
    }
    em_line(e, "else")
    em_line(e, "\{")
    e.ind += 1
    es_push(es)
    emit_arm_body(e, els, es, tid)
    es_pop(es)
    e.ind -= 1
    em_line(e, "\}")
  }
}

// arm body: statements normally; a trailing expression-statement (or a
// trailing if-expression) stores its value into the chain's temp
fn emit_arm_body(e: inout Em, b: in Node, es: inout [EmScope], tid: Int) {
  var i = 0
  while i < b.kids.len() {
    let s = b.kids.get(i).unwrap()
    let is_last = i == b.kids.len() - 1
    if is_last and s.tag == "exprstmt" {
      let v = emit_expr(e, s.kids.get(0).unwrap(), es)
      em_line(e, "v_{tid} = {v};")
    } else if is_last and s.tag == "if" {
      let v = emit_if_expr(e, s, es)
      em_line(e, "v_{tid} = {v};")
    } else {
      emit_stmt(e, s, es)
    }
    i += 1
  }
}

fn join_csv(parts: [Str]) -> Str {
  if parts.len() == 0 {
    return ""
  }
  var out = parts.get(0).unwrap()
  var i = 1
  while i < parts.len() {
    out += ", "
    out += parts.get(i).unwrap()
    i += 1
  }
  out
}

// ---------- statements ----------

fn emit_stmt(e: inout Em, s: in Node, es: inout [EmScope]) {
  if s.tag == "let" or s.tag == "var" {
    let init = emit_expr(e, s.kids.get(0).unwrap(), es)
    let mng = es_declare(e, es, s.s1)
    em_line(e, "object {mng} = {init};")
    return
  }
  if s.tag == "assign" or s.tag == "opassign" {
    emit_store(e, s, es)
    return
  }
  if s.tag == "exprstmt" {
    let inner = s.kids.get(0).unwrap()
    var v = ""
    var voidcall = false
    if inner.tag == "call" {
      // direct calls whose ARBOR signature is Unit must not be wrapped in
      // RT.Eval — their C# counterpart may return void or be discarded
      let callee_node = inner.kids.get(0).unwrap()
      if inner.s1 == "" {
        let nm2 = callee_node.s1
        if nm2 == "println" or nm2 == "print" or nm2 == "assert" or nm2 == "assert_eq" or nm2 == "drop" {
          voidcall = true
        }
      }
    }
    if voidcall {
      v = emit_expr(e, inner, es)
      em_line(e, "{v};")
    } else {
      v = emit_expr(e, inner, es)
      em_line(e, "RT.Eval({v});")
    }
    return
  }
  if s.tag == "return" {
    if s.kids.len() > 0 {
      let v = emit_expr(e, s.kids.get(0).unwrap(), es)
      em_line(e, "return {v};")
    } else {
      em_line(e, "return RT.UNIT;")
    }
    return
  }
  if s.tag == "break" {
    em_line(e, "break;")
    return
  }
  if s.tag == "cont" {
    em_line(e, "continue;")
    return
  }
  if s.tag == "if" {
    emit_if(e, s, es)
    return
  }
  if s.tag == "while" {
    let cond = emit_expr(e, s.kids.get(0).unwrap(), es)
    em_line(e, "while (RT.Truthy({cond}))")
    em_line(e, "\{")
    e.ind += 1
    es_push(es)
    let body = s.kids.get(1).unwrap()
    emit_block(e, body, es, false)
    es_pop(es)
    e.ind -= 1
    em_line(e, "\}")
    return
  }
  if s.tag == "forin" {
    let iter = emit_expr(e, s.kids.get(0).unwrap(), es)
    let tid = fresh(e)
    em_line(e, "ABV it_{tid} = RT.Iter({iter});")
    em_line(e, "for (int i_{tid} = 0; i_{tid} < it_{tid}.L.Count; i_{tid}++)")
    em_line(e, "\{")
    e.ind += 1
    es_push(es)
    let mng = es_declare(e, es, s.s1)
    em_line(e, "object {mng} = it_{tid}.L[i_{tid}];")
    let body = s.kids.get(1).unwrap()
    emit_block(e, body, es, false)
    es_pop(es)
    e.ind -= 1
    em_line(e, "\}")
    return
  }
  if s.tag == "match" {
    emit_match(e, s, es)
    return
  }
  em_line(e, "/* unhandled stmt {s.tag} */")
}

fn emit_if(e: inout Em, s: in Node, es: inout [EmScope]) {
  let cond = emit_expr(e, s.kids.get(0).unwrap(), es)
  em_line(e, "if (RT.Truthy({cond}))")
  em_line(e, "\{")
  e.ind += 1
  es_push(es)
  let thenb = s.kids.get(1).unwrap()
  emit_block(e, thenb, es, false)
  es_pop(es)
  e.ind -= 1
  if s.kids.len() > 2 {
    let els = s.kids.get(2).unwrap()
    em_line(e, "\}")
    em_line(e, "else")
    em_line(e, "\{")
    e.ind += 1
    es_push(es)
    if els.tag == "block" {
      emit_block(e, els, es, false)
    } else {
      emit_stmt(e, els, es)
    }
    es_pop(es)
    e.ind -= 1
    em_line(e, "\}")
  } else {
    em_line(e, "\}")
  }
}

fn emit_block(e: inout Em, b: in Node, es: inout [EmScope], fn_body: Bool) {
  var i = 0
  while i < b.kids.len() {
    let s = b.kids.get(i).unwrap()
    let is_last = i == b.kids.len() - 1
    let is_tail = fn_body and e.fnret != "" and is_last and (s.tag == "exprstmt" or s.tag == "if")
    if is_tail and s.tag == "exprstmt" {
      let v = emit_expr(e, s.kids.get(0).unwrap(), es)
      em_line(e, "return {v};")
    } else if is_tail and s.tag == "if" {
      let v = emit_if_expr(e, s, es)
      em_line(e, "return {v};")
    } else {
      emit_stmt(e, s, es)
    }
    i += 1
  }
}

fn emit_store(e: inout Em, s: in Node, es: inout [EmScope]) {
  let target = s.kids.get(0).unwrap()
  let rhs = emit_expr(e, s.kids.get(1).unwrap(), es)
  var val = rhs
  if s.tag == "opassign" {
    var base_op = "+"
    if s.s1 == "-=" {
      base_op = "-"
    } else if s.s1 == "*=" {
      base_op = "*"
    } else if s.s1 == "/=" {
      base_op = "/"
    }
    let cur = emit_place_read(e, target, es)
    val = emit_binop(base_op, cur, rhs)
  }
  emit_place_write(e, target, val, es)
}

fn emit_place_read(e: inout Em, t: in Node, es: inout [EmScope]) -> Str {
  if t.tag == "ident" {
    return es_lookup(es, t.s1)
  }
  if t.tag == "fieldget" {
    let recv = emit_expr(e, t.kids.get(0).unwrap(), es)
    return "RT.FGet({recv}, \"{t.s1}\")"
  }
  if t.tag == "index" {
    let obj = emit_expr(e, t.kids.get(0).unwrap(), es)
    let idx = emit_expr(e, t.kids.get(1).unwrap(), es)
    return "RT.Get({obj}, {idx})"
  }
  "RT.UNIT"
}

fn emit_place_write(e: inout Em, t: in Node, val: Str, es: inout [EmScope]) {
  if t.tag == "ident" {
    let mng = es_lookup(es, t.s1)
    em_line(e, "{mng} = {val};")
    return
  }
  if t.tag == "fieldget" {
    let recv = emit_expr(e, t.kids.get(0).unwrap(), es)
    em_line(e, "RT.FSet({recv}, \"{t.s1}\", {val});")
    return
  }
  if t.tag == "index" {
    let obj = emit_expr(e, t.kids.get(0).unwrap(), es)
    let idx = emit_expr(e, t.kids.get(1).unwrap(), es)
    em_line(e, "RT.SetIdx({obj}, {idx}, {val});")
    return
  }
  em_line(e, "/* bad store */")
}

fn emit_match(e: inout Em, m: in Node, es: inout [EmScope]) {
  let subj_node = m.kids.get(0).unwrap()
  let subject = subj_node.kids.get(0).unwrap()
  let sv = emit_expr(e, subject, es)
  let sid = fresh(e)
  em_line(e, "\{")
  e.ind += 1
  em_line(e, "object ms_{sid} = {sv};")
  var ai = 1
  while ai < m.kids.len() {
    let arm = m.kids.get(ai).unwrap()
    var kw = "if"
    if ai > 1 {
      kw = "else if"
    }
    em_line(e, "{kw} (RT.VIs(ms_{sid}, \"{arm.s1}\"))")
    em_line(e, "\{")
    e.ind += 1
    es_push(es)
    var bi = 0
    while bi < arm.kids.len() - 1 {
      let bnd = arm.kids.get(bi).unwrap()
      let bmng = es_declare(e, es, bnd.s1)
      em_line(e, "object {bmng} = RT.VPay(ms_{sid}, {bi});")
      bi += 1
    }
    let body = arm.kids.get(arm.kids.len() - 1).unwrap()
    emit_block(e, body, es, false)
    es_pop(es)
    e.ind -= 1
    em_line(e, "\}")
    ai += 1
  }
  em_line(e, "else RT.Trap(\"non-exhaustive match\");")
  e.ind -= 1
  em_line(e, "\}")
}

// ---------- functions & program ----------

fn emit_fn(e: inout Em, f: in Node) {
  var ps: [Str] = []
  var decls: [Str] = []
  var i = 0
  while i < f.kids.len() - 1 {
    let prm = f.kids.get(i).unwrap()
    let mng = prm.s1 + "_p{i}"
    ps.push("object {mng}")
    decls.push(mng)
    i += 1
  }
  e.fnret = f.s2
  em_line(e, "public static object F_{f.s1}({join_csv(ps)})")
  em_line(e, "\{")
  e.ind += 1
  var es: [EmScope] = []
  es_push(es)
  var di = 0
  while di < decls.len() {
    let src_name = f.kids.get(di).unwrap().s1
    let mng = decls.get(di).unwrap()
    var fr = es.get(es.len() - 1).unwrap()
    fr.orig.push(src_name)
    fr.mng.push(mng)
    di += 1
  }
  let body = f.kids.get(f.kids.len() - 1).unwrap()
  emit_block(e, body, es, true)
  if f.s2 == "" {
    em_line(e, "return RT.UNIT;")
  }
  es.pop()
  e.ind -= 1
  em_line(e, "\}")
  e.fnret = ""
}

fn rt_prelude() -> Str {
  var ls: [Str] = []
  ls.push("using System;")
  ls.push("using System.Collections.Generic;")
  ls.push("using System.Linq;")
  ls.push("public class ABV \{ public List<object> L = new List<object>(); \}")
  ls.push("public class STC \{ public string T; public string[] N; public List<object> F = new List<object>(); \}")
  ls.push("public class OV \{ public string K; public object V; public object V2; public object X; \}")
  ls.push("public static class RT \{")
  ls.push("  public static readonly object UNIT = new object();")
  ls.push("  public static object Eval(object v) \{ return v; \}")
  ls.push("  public static bool Truthy(object v) \{ return v is bool && (bool)v; \}")
  ls.push("  public static void Trap(string msg) \{ Console.Error.WriteLine(\"trap: \" + msg); Environment.Exit(1); \}")
