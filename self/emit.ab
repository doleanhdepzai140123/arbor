  ls.push("    if (name == \"lower\") return ((string)recv).ToLower();")
  ls.push("    if (name == \"chars\") \{ ABV r = new ABV(); foreach (char c in (string)recv) r.L.Add(c.ToString()); return r; \}")
  ls.push("    if (name == \"repeat\") return string.Concat(System.Linq.Enumerable.Repeat((string)recv, (int)(long)a[0]));")
  ls.push("    if (name == \"to_str\") return ToShow(recv);")
  ls.push("    if (name == \"to_int\") \{ long n2; if (long.TryParse((string)recv, out n2)) return Ok((object)n2); return Err((object)\"not a number\"); \}")
  ls.push("    if (name == \"starts_with\") return (object)((string)recv).StartsWith((string)a[0]);")
  ls.push("    if (name == \"ends_with\") return (object)((string)recv).EndsWith((string)a[0]);")
  ls.push("    if (name == \"replace\") return ((string)recv).Replace((string)a[0], (string)a[1]);")
  ls.push("    if (name == \"first\" || name == \"last\") \{ ABV b = (ABV)recv; if (b.L.Count == 0) return None(); return Some(name == \"first\" ? b.L[0] : b.L[b.L.Count - 1]); \}")
  ls.push("    if (name == \"unwrap_or\") \{ if (IsKind(recv, \"Some\") || IsKind(recv, \"Ok\")) return Unwrap(recv); return a[0]; \}")
  ls.push("    if (name == \"unwrap\") return Unwrap(recv);")
  ls.push("    if (name == \"expect\") \{ if (!(IsKind(recv, \"Some\") || IsKind(recv, \"Ok\"))) Trap(\"expect: \" + ToShow(a[0])); return Unwrap(recv); \}")
  ls.push("    if (name == \"is_ok\" || name == \"is_some\") return (object)(IsKind(recv, \"Ok\") || IsKind(recv, \"Some\"));")
  ls.push("    if (name == \"is_err\" || name == \"is_none\") return (object)(IsKind(recv, \"Err\") || IsKind(recv, \"None\"));")
