  ls.push("  public static object FGet(object o, string name) \{ STC s2 = o as STC; if (s2 == null) Trap(\"field access on non-struct\"); for (int i = 0; i < s2.N.Length; i++) if (s2.N[i] == name) return s2.F[i]; Trap(\"no field \" + name); return UNIT; \}")
