fn classify(n: Int) -> Str {
  if n < 0 { "am" } else if n == 0 { "khong" } else { "duong" }
}

fn main() {
  var i = 0
  while i < 3 {
    println("i={i}")
    i = i + 1
  }

  for x in [10, 20, 30] {
    println("x={x}")
  }

  for ch in "ab" {
    println("ch={ch}")
  }

  println(classify(-5))
  println(classify(0))
  println(classify(7))

  let msg = match classify(100) {
    "duong" => "so duong roi"
    _ => "gi khac"
  }
  println(msg)
}
