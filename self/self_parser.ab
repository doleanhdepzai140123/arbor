// self_parser.ab — ARBOR parser written in ARBOR
// Recursive descent parser that directly emits C# code.
// Uses the Parser struct to track token position.

struct Parser {
  toks: [Token]
  pos: Int
  out: [Str]
  indent: Int
}

fn P_new(toks: [Token]) -> Parser {
  Parser { toks: toks, pos: 0, out: [], indent: 2 }
}

fn P_peek(p: Parser) -> Token { p.toks[p.pos] }
fn P_kind(p: Parser) -> Str { p.toks[p.pos].kind }
fn P_val(p: Parser) -> Str { p.toks[p.pos].value }

fn P_advance(p: inout Parser) -> Token {
  let t = p.toks[p.pos]
  if p.pos < p.toks.len() - 1 { p.pos += 1 }
  t
}

fn P_at(p: Parser, kind: Str) -> Bool { p.toks[p.pos].kind == kind }
fn P_expect(p: inout Parser, kind: Str) -> Token {
  if not P_at(p, kind) {
    println("PARSE ERROR: expected '{kind}' got '{P_val(p)}' at line {P_peek(p).line}")
    std.process.exit(1)
  }
  P_advance(p)
}

fn P_emit(p: inout Parser, s: Str) {
  var pad = ""
  var i = 0
  while i < p.indent { pad += "    "; i += 1 }
  p.out.push(pad + s)
}

fn P_stmts(p: inout Parser) {
  while not P_at(p, "}") and not P_at(p, "eof") {
    P_stmt(p)
  }
}

fn P_stmt(p: inout Parser) {
  let k = P_kind(p)
  if k == "let" or k == "var" { P_let(p) }
  else if k == "return" { P_return(p) }
  else if k == "if" { P_if(p) }
  else if k == "while" { P_while(p) }
  else if k == "for" { P_for(p) }
  else { P_expr_stmt(p) }
}

fn P_let(p: inout Parser) {
  P_advance(p)
  let name = P_val(p)
  P_advance(p)
  P_expect(p, "=")
  let expr = P_expr(p)
  P_emit(p, "var " + name + " = " + expr + ";")
}

fn P_return(p: inout Parser) {
  P_advance(p)
  if P_at(p, "}") {
    P_emit(p, "return RT.UNIT;")
  } else {
    let e = P_expr(p)
    P_emit(p, "return " + e + ";")
  }
}

fn P_if(p: inout Parser) {
  P_advance(p)
  let cond = P_expr(p)
  P_emit(p, "if (RT.Truthy(" + cond + ")) {")
  P_indent(p)
  P_block(p)
  P_dedent(p)
  if P_at(p, "else") {
    P_advance(p)
    if P_at(p, "if") {
      P_emit(p, "} else {")
      P_indent(p)
      P_if(p)
      P_dedent(p)
      P_emit(p, "}")
    } else {
      P_emit(p, "} else {")
      P_indent(p)
      P_block(p)
      P_dedent(p)
      P_emit(p, "}")
    }
  } else {
    P_emit(p, "}")
  }
}

fn P_while(p: inout Parser) {
  P_advance(p)
  let cond = P_expr(p)
  P_emit(p, "while (RT.Truthy(" + cond + ")) {")
  P_indent(p)
  P_block(p)
  P_dedent(p)
  P_emit(p, "}")
}

fn P_for(p: inout Parser) {
  P_advance(p)
  let var_name = P_val(p)
  P_advance(p)
  P_expect(p, "in")
  let iter = P_expr(p)
  P_emit(p, "foreach (var " + var_name + " in RT.Iterate(" + iter + ")) {")
  P_indent(p)
  P_block(p)
  P_dedent(p)
  P_emit(p, "}")
}

fn P_block(p: inout Parser) {
  P_expect(p, "{")
  P_stmts(p)
  P_expect(p, "}")
}

fn P_indent(p: inout Parser) { p.indent += 1 }
fn P_dedent(p: inout Parser) { p.indent -= 1 }

fn P_expr_stmt(p: inout Parser) {
  let e = P_expr(p)
  P_emit(p, e + ";")
}

// ===== EXPRESSION PARSING (precedence climbing) =====
fn P_expr(p: inout Parser) -> Str { P_binary(p, 0) }

fn P_prec(op: Str) -> Int {
  if op == "or" { return 1 }
  if op == "and" { return 2 }
  if op == "==" { return 3 }
  if op == "!=" { return 3 }
  if op == "<" { return 4 }
  if op == ">" { return 4 }
  if op == "<=" { return 4 }
  if op == ">=" { return 4 }
  if op == "+" { return 5 }
  if op == "-" { return 5 }
  if op == "*" { return 6 }
  if op == "/" { return 6 }
  if op == "%" { return 6 }
  return 0
}

fn P_is_binop(p: Parser) -> Bool {
  let k = P_kind(p)
  if k == "and" { return true }
  if k == "or" { return true }
  if k == "+" { return true }
  if k == "-" { return true }
  if k == "*" { return true }
  if k == "/" { return true }
  if k == "%" { return true }
  if k == "==" { return true }
  if k == "!=" { return true }
  if k == "<" { return true }
  if k == ">" { return true }
  if k == "<=" { return true }
  if k == ">=" { return true }
  return false
}

fn P_binop_cs(op: Str, l: Str, r: Str) -> Str {
  if op == "+" { return "RT.Add(" + l + ", " + r + ")" }
  if op == "-" { return "RT.Sub(" + l + ", " + r + ")" }
  if op == "*" { return "RT.Mul(" + l + ", " + r + ")" }
  if op == "/" { return "RT.Div(" + l + ", " + r + ")" }
  if op == "%" { return "RT.Rem(" + l + ", " + r + ")" }
  if op == "==" { return "RT.Eq(" + l + ", " + r + ")" }
  if op == "!=" { return "RT.Ne(" + l + ", " + r + ")" }
  if op == "<" { return "RT.Lt(" + l + ", " + r + ")" }
  if op == ">" { return "RT.Gt(" + l + ", " + r + ")" }
  if op == "<=" { return "RT.Le(" + l + ", " + r + ")" }
  if op == ">=" { return "RT.Ge(" + l + ", " + r + ")" }
  if op == "and" { return "RT.Truthy(" + l + ") ? " + r + " : (object)false" }
  if op == "or" { return "RT.Truthy(" + l + ") ? (object)true : " + r }
  return l
}

fn P_binary(p: inout Parser, min_prec: Int) -> Str {
  var left = P_unary(p)
  while P_is_binop(p) {
    let op = P_val(p)
    let prec = P_prec(op)
    if prec < min_prec { break }
    P_advance(p)
    let right = P_binary(p, prec + 1)
    left = P_binop_cs(op, left, right)
  }
  left
}

fn P_unary(p: inout Parser) -> Str {
  if P_at(p, "-") {
    P_advance(p)
    let v = P_unary(p)
    return "RT.Neg(" + v + ")"
  }
  P_postfix(p)
}

fn P_postfix(p: inout Parser) -> Str {
  var e = P_primary(p)
  while true {
    if P_at(p, ".") {
      P_advance(p)
      let name = P_val(p)
      P_advance(p)
      if P_at(p, "(") {
        let args = P_args(p)
        e = "RT.CallMethod(" + e + ", \"" + name + "\", new object[] { " + args + " })"
      } else {
        e = "RT.StructGet(" + e + ", \"" + name + "\")"
      }
    } else if P_at(p, "(") {
      let args = P_args(p)
      e = "RT.CallFn(" + e + ", new object[] { " + args + " })"
    } else if P_at(p, "[") {
      P_advance(p)
      let idx = P_expr(p)
      P_expect(p, "]")
      e = "RT.StrIdx(" + e + ", " + idx + ")"
    } else {
      break
    }
  }
  e
}

fn P_args(p: inout Parser) -> Str {
  P_expect(p, "(")
  var args: [Str] = []
  if not P_at(p, ")") {
    args.push(P_expr(p))
    while P_at(p, ",") {
      P_advance(p)
      args.push(P_expr(p))
    }
  }
  P_expect(p, ")")
  args.join(", ")
}

fn P_primary(p: inout Parser) -> Str {
  let k = P_kind(p)
  let v = P_val(p)
  if k == "int" { P_advance(p); return "(object)(long)(" + v + ")" }
  if k == "string" { P_advance(p); return "(object)" + v }
  if k == "true" { P_advance(p); return "(object)true" }
  if k == "false" { P_advance(p); return "(object)false" }
  if k == "ident" { P_advance(p); return v }
  if k == "(" {
    P_advance(p)
    let inner = P_expr(p)
    P_expect(p, ")")
    return inner
  }
  P_advance(p)
  return "RT.UNIT"
}
