  ls.push("  public static object Exec(object cmd, object argv) \{ try \{ var psi = new System.Diagnostics.ProcessStartInfo(); psi.FileName = (string)cmd; psi.Arguments = \"\"; string q = ((char)34).ToString(); string bs = ((char)92).ToString(); foreach (object a in ((ABV)argv).L) \{ string s3 = (string)a; psi.Arguments += (psi.Arguments.Length == 0 ? \"\" : \" \") + q + s3.Replace(q, bs + q) + q; \} psi.UseShellExecute = false; psi.RedirectStandardOutput = true; psi.RedirectStandardError = true; var pr2 = System.Diagnostics.Process.Start(psi); string so = pr2.StandardOutput.ReadToEnd(); pr2.WaitForExit(); if (pr2.ExitCode != 0) return Err(\"exit \" + pr2.ExitCode + \": \" + pr2.StandardError.ReadToEnd()); return Ok(so); \} catch (Exception e2) \{ return Err(e2.Message); \} \}")
  ls.push("  public static object WriteFile(object path, object data) \{ try \{ System.IO.File.WriteAllText((string)path, (string)data); return Ok((object)(long)((string)data).Length); \} catch (Exception e2) \{ return Err(e2.Message); \} \}")
