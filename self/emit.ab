  ls.push("    if (name == \"split\") \{ ABV r = new ABV(); var parts = ((string)recv).Split(new string[] \{ (string)a[0] \}, StringSplitOptions.None); foreach (string p in parts) r.L.Add(p); return r; \}")
  ls.push("    if (name == \"trim\") return ((string)recv).Trim();")
