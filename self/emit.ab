  ls.push("    if (name == \"get\") \{ long i = (long)a[0]; if (recv is ABV) \{ ABV b = (ABV)recv; if (i < 0 || i >= b.L.Count) return None(); return Some(b.L[(int)i]); \} string s3 = (string)recv; if (i < 0 || i >= s3.Length) return None(); return Some(s3[(int)i].ToString()); \}")
  ls.push("    if (name == \"push\") \{ ((ABV)recv).L.Add(a[0]); return UNIT; \}")
  ls.push("    if (name == \"set\") \{ ABV b = (ABV)recv; b.L[(int)(long)a[0]] = a[1]; return UNIT; \}")
