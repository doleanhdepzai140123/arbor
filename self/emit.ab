  join_lines(ls)
}

fn join_lines(ls: [Str]) -> Str {
  if ls.len() == 0 {
    return ""
  }
  var out = ls.get(0).unwrap()
  var i = 1
  while i < ls.len() {
    out += "\n"
    out += ls.get(i).unwrap()
    i += 1
  }
  out
}

fn in_str_list(ls: [Str], s: Str) -> Bool {
  for x in ls {
    if x == s {
      return true
    }
  }
  false
}

// collect every function name in the program (through filescope groups)
fn collect_fn_names(prog: in Node, e: inout Em) {
  var gi = 0
  while gi < prog.kids.len() {
    let g = prog.kids.get(gi).unwrap()
    if g.tag == "filescope" {
      var fi = 0
      while fi < g.kids.len() {
        let d = g.kids.get(fi).unwrap()
        if d.tag == "fndef" {
          e.fns.push(d.s1)
        }
        fi += 1
      }
    } else if g.tag == "fndef" {
      e.fns.push(g.s1)
    }
    gi += 1
  }
}

// emit one declaration if it is a function
fn emit_decl(e: inout Em, d: in Node) {
  if d.tag == "fndef" {
    emit_fn(e, d)
  }
}

fn emit_program(prog: in Node) -> Str {
  var e = Em { out: [], ind: 0, tmp: 100, origs: [], mngs: [], fnret: "", fns: [] }
  collect_fn_names(prog, e)
  var pre = rt_prelude()
  em_line(e, "public static class Program \{")
  e.ind += 1
  // main first (entry point), then everything else
  var pass = 0
  while pass < 2 {
    var gi = 0
    while gi < prog.kids.len() {
      let g = prog.kids.get(gi).unwrap()
      if g.tag == "filescope" {
        var fi = 0
        while fi < g.kids.len() {
          let d = g.kids.get(fi).unwrap()
          if d.tag == "fndef" {
            let is_main = d.s1 == "main"
            if (pass == 0 and is_main) or (pass == 1 and not is_main) {
              emit_fn(e, d)
            }
          }
          fi += 1
        }
      } else if g.tag == "fndef" {
        let is_main2 = g.s1 == "main"
        if (pass == 0 and is_main2) or (pass == 1 and not is_main2) {
          emit_fn(e, g)
        }
      }
      gi += 1
    }
    pass += 1
  }
  em_line(e, "public static void Main() \{ F_main(); \}")
  e.ind -= 1
  em_line(e, "\}")
  var code = join_lines(e.out)
  var full = pre + "\n" + code + "\n"
  full
}
