  ls.push("    if (name == \"clone\") \{ ABV b = (ABV)recv; ABV r = new ABV(); foreach (object x in b.L) r.L.Add(x); return r; \}")
  ls.push("    if (name == \"contains\") \{ if (recv is ABV) \{ foreach (object x in ((ABV)recv).L) if (Eq(x, a[0])) return (object)true; return (object)false; \} return (object)((string)recv).Contains((string)a[0]); \}")
  ls.push("    if (name == \"is_empty\") return (object)(Len(recv) == 0);")
